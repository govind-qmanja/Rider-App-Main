<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="8dp">

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">

        <TextView android:id="@+id/tv_restaurant_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Restaurant Name" android:textSize="14sp" android:textStyle="bold" android:textColor="@android:color/white" />

        <TextView android:id="@+id/tv_amount" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="₹0.00" android:textSize="14sp" android:textColor="@android:color/white" android:textStyle="bold" />

        <TextView android:id="@+id/tv_order_details" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Details..." android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>

    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">

        <Button android:id="@+id/btn_reject" style="?android:attr/borderlessButtonStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Stop Alert" android:textColor="#f5766dff" />

        <Button android:id="@+id/btn_accept" style="?android:attr/borderlessButtonStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Accept" android:textColor="#9df7a0ff" />
    </LinearLayout>

</LinearLayout>
