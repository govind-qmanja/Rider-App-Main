<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#37555A" android:keepScreenOn="true">



    <!-- Main White Card -->
    <com.google.android.material.card.MaterialCardView android:id="@+id/card_main" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="24dp" app:cardBackgroundColor="#FFFFFF" app:cardCornerRadius="24dp" app:cardElevation="12dp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintVertical_bias="0.45">

        <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="56dp">            <!-- Extra padding for overlapping buttons -->

            <!-- Space to clear the overlapping top app icon -->
            <Space android:id="@+id/space_top" android:layout_width="wrap_content" android:layout_height="56dp" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />

            <!-- Head: Restaurant Name -->
            <TextView android:id="@+id/tv_restaurant_name" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginHorizontal="24dp" android:fontFamily="sans-serif-medium" android:gravity="center" android:textColor="#1A1A1A" android:textSize="20sp" android:textStyle="bold" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/space_top" tools:text="Pizza Palace" />

            <!-- Restaurant Icon (Replacing Profile Icon) -->
            <com.google.android.material.card.MaterialCardView android:id="@+id/cv_avatar" android:layout_width="56dp" android:layout_height="56dp" android:layout_marginStart="32dp" android:layout_marginTop="32dp" app:cardBackgroundColor="#F0F0F0" app:cardCornerRadius="28dp" app:cardElevation="0dp" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/tv_restaurant_name">

                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:padding="0dp" android:scaleType="centerCrop" android:src="@drawable/restaurant" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Order ID -->
            <TextView android:id="@+id/tv_header_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:fontFamily="sans-serif-medium" android:textColor="#1A1A1A" android:textSize="18sp" app:layout_constraintBottom_toTopOf="@+id/tv_amount" app:layout_constraintStart_toEndOf="@+id/cv_avatar" app:layout_constraintTop_toTopOf="@+id/cv_avatar" app:layout_constraintVertical_chainStyle="packed" tools:text="Order #12345" />

            <!-- Price -->
            <TextView android:id="@+id/tv_amount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_marginTop="4dp" android:textColor="#232222" android:textSize="15sp" app:layout_constraintBottom_toBottomOf="@+id/cv_avatar" app:layout_constraintStart_toEndOf="@+id/cv_avatar" app:layout_constraintTop_toBottomOf="@+id/tv_header_label" tools:text="₹1,250.00" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Top Overlapping App Icon (Elevation fixed to 24dp) -->
    <com.google.android.material.card.MaterialCardView android:id="@+id/cv_app_icon_container" android:layout_width="80dp" android:layout_height="80dp" app:cardBackgroundColor="#FFFFFF" app:cardCornerRadius="40dp" app:cardElevation="24dp" app:layout_constraintBottom_toTopOf="@+id/card_main" app:layout_constraintEnd_toEndOf="@+id/card_main" app:layout_constraintStart_toStartOf="@+id/card_main" app:layout_constraintTop_toTopOf="@+id/card_main">

        <!-- Inner Yellow Background -->
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="match_parent" android:layout_margin="4dp" app:cardBackgroundColor="#FFD600" app:cardCornerRadius="36dp" app:cardElevation="0dp">

            <ImageView android:id="@+id/iv_app_icon" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="16dp" android:src="@mipmap/ic_launcher" />
        </com.google.android.material.card.MaterialCardView>
    </com.google.android.material.card.MaterialCardView>

    <!-- Positioning Guidelines for Bottom Action Buttons -->
    <androidx.constraintlayout.widget.Guideline android:id="@+id/guide_left_btn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" app:layout_constraintGuide_percent="0.32" />

    <androidx.constraintlayout.widget.Guideline android:id="@+id/guide_right_btn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" app:layout_constraintGuide_percent="0.68" />

    <!-- Action Button: Stop Alert Container (Elevation fixed to 24dp) -->
    <FrameLayout android:id="@+id/btn_stop_alert_container" android:layout_width="wrap_content" android:layout_height="wrap_content" android:elevation="24dp" app:layout_constraintBottom_toBottomOf="@+id/card_main" app:layout_constraintEnd_toEndOf="@+id/guide_left_btn" app:layout_constraintStart_toStartOf="@+id/guide_left_btn" app:layout_constraintTop_toBottomOf="@+id/card_main">

        <com.google.android.material.button.MaterialButton android:id="@+id/btn_stop_alert" android:layout_width="72dp" android:layout_height="72dp" android:insetLeft="0dp" android:insetTop="0dp" android:insetRight="0dp" android:insetBottom="0dp" android:text="✕" android:textColor="#FF3B30" android:textSize="26sp" app:backgroundTint="#FFFFFF" app:cornerRadius="36dp" app:strokeColor="#FF3B30" app:strokeWidth="1.5dp" />
    </FrameLayout>

    <!-- Deny Label -->
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:fontFamily="sans-serif-medium" android:text="Ignore" android:textColor="#FFFFFF" android:textSize="14sp" app:layout_constraintEnd_toEndOf="@+id/btn_stop_alert_container" app:layout_constraintStart_toStartOf="@+id/btn_stop_alert_container" app:layout_constraintTop_toBottomOf="@+id/btn_stop_alert_container" />

    <!-- Action Button: Accept Container (Elevation fixed to 24dp) -->
    <FrameLayout android:id="@+id/btn_view_details_container" android:layout_width="wrap_content" android:layout_height="wrap_content" android:elevation="24dp" app:layout_constraintBottom_toBottomOf="@+id/card_main" app:layout_constraintEnd_toEndOf="@+id/guide_right_btn" app:layout_constraintStart_toStartOf="@+id/guide_right_btn" app:layout_constraintTop_toBottomOf="@+id/card_main">

        <com.google.android.material.button.MaterialButton android:id="@+id/btn_view_details" android:layout_width="72dp" android:layout_height="72dp" android:insetLeft="0dp" android:insetTop="0dp" android:insetRight="0dp" android:insetBottom="0dp" android:text="✓" android:textColor="#FFFFFF" android:textSize="30sp" app:backgroundTint="#34C759" app:cornerRadius="36dp" />
    </FrameLayout>

    <!-- Approve Label -->
    <TextView android:id="@+id/tv_accept_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:fontFamily="sans-serif-medium" android:text="Accept" android:textColor="#FFFFFF" android:textSize="14sp" app:layout_constraintEnd_toEndOf="@+id/btn_view_details_container" app:layout_constraintStart_toStartOf="@+id/btn_view_details_container" app:layout_constraintTop_toBottomOf="@+id/btn_view_details_container" />

    <!-- View Detail Button (Opens Application) -->
    <com.google.android.material.button.MaterialButton android:id="@+id/btn_open_app_main" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="32dp" android:paddingHorizontal="32dp" android:text="View Detail" android:textAllCaps="false" android:textColor="#000000" android:textSize="14sp" app:backgroundTint="#FFFFFF" app:cornerRadius="24dp" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@+id/tv_accept_label" />

</androidx.constraintlayout.widget.ConstraintLayout>